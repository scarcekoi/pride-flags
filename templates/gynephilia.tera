---
whiskers:
  version: "^2.9.0"
  matrix:
    - variant: ["css", "svg"]
    - flavor
  filename: "themes/{{flavor.identifier}}/gynephilia/gynephilia.{{ variant }}"
  hex_format: "#{{r}}{{g}}{{b}}{{z}}"
---
/* themes/{{flavor.identifier}}/gynephilia/gynephilia.{{ variant }} */
{%- if variant == "css" %}
:root {
  --ctp-{{flavor.identifier}}-gynephilia-white: {{if(cond=flavor.light, t=crust.hex, f=text.hex)}};
  --ctp-{{flavor.identifier}}-gynephilia-gray: {{overlay0.hex}};
  --ctp-{{flavor.identifier}}-gynephilia-purple: {{mauve.hex}};
}
{%- elif variant == "svg" %}
<?xml version="1.0" encoding="UTF-8" ?>
<svg version="1.1" width="800" height="400" xmlns="http://www.w3.org/2000/svg" shape-rendering="crispEdges">
<rect x="0" y="0" width="800" height="100" fill="{{if(cond=flavor.light, t=text.hex, f=crust.hex)}}" />
<rect x="0" y="100" width="800" height="100" fill="{{overlay0.hex}}" />
<rect x="0" y="200" width="800" height="100" fill="{{if(cond=flavor.light, t=crust.hex, f=text.hex)}}" />
<rect x="0" y="300" width="800" height="100" fill="{{mauve.hex}}" />
</svg>
{% endif %}
