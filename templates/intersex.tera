---
whiskers:
  version: "^2.9.0"
  matrix:
    - variant: ["css", "svg"]
    - flavor
  filename: "themes/{{flavor.identifier}}/intersex/intersex.{{ variant }}"
  hex_format: "#{{r}}{{g}}{{b}}{{z}}"
---
/* themes/{{flavor.identifier}}/intersex/intersex.{{ variant }} */
{%- if variant == "css" %}
:root {
  --ctp-{{flavor.identifier}}-intersex-yellow: {{yellow.hex}};
  --ctp-{{flavor.identifier}}-intersex-purple: {{mauve.hex}};
}
{%- elif variant == "svg" %}
<svg xmlns="http://www.w3.org/2000/svg" width="600" height="300" viewBox="0 0 600 300">
  <path fill="{{yellow.hex}}" stroke="{{yellow.hex}}"  d="M0 0h600v300H0z"/>
  <circle cx="300" cy="150" r="73.5" fill="none" stroke-width="25" stroke="{{mauve.hex}}"/>
</svg>
{% endif %}
