---
whiskers:
  version: "^2.9.0"
  matrix:
    - variant: ["css", "svg"]
    - flavor
  filename: "themes/{{flavor.identifier}}/agender/agender.{{ variant }}"
  hex_format: "#{{r}}{{g}}{{b}}{{z}}"
---
/* themes/{{flavor.identifier}}/agender/agender.{{ variant }} */
{%- if variant == "css" %}
:root {
  --ctp-{{flavor.identifier}}-agender-black: {{if(cond=flavor.light, t=text.hex, f=crust.hex)}};
  --ctp-{{flavor.identifier}}-agender-gray: {{overlay0.hex}};
  --ctp-{{flavor.identifier}}-agender-white: {{if(cond=flavor.light, t=crust.hex, f=text.hex)}};
  --ctp-{{flavor.identifier}}-agender-green: {{green.hex}};
}
{%- elif variant == "svg" %}
<?xml version="1.0" encoding="UTF-8" ?>
<svg version="1.1" width="1400" height="700" xmlns="http://www.w3.org/2000/svg" shape-rendering="crispEdges">
<rect x="0" y="0" width="1400" height="100" fill="{{if(cond=flavor.light, t=text.hex, f=crust.hex)}}" stroke="{{if(cond=flavor.light, t=text.hex, f=crust.hex)}}" />
<rect x="0" y="100" width="1400" height="100" fill="{{overlay0.hex}}" stroke="{{overlay0.hex}}" />
<rect x="0" y="200" width="1400" height="100" fill="{{if(cond=flavor.light, t=crust.hex, f=text.hex)}}" stroke="{{if(cond=flavor.light, t=crust.hex, f=text.hex)}}" />
<rect x="0" y="300" width="1400" height="100" fill="{{green.hex}}" stroke="{{green.hex}}" />
<rect x="0" y="400" width="1400" height="100" fill="{{if(cond=flavor.light, t=crust.hex, f=text.hex)}}" stroke="{{if(cond=flavor.light, t=crust.hex, f=text.hex)}}" />
<rect x="0" y="500" width="1400" height="100" fill="{{overlay0.hex}}" stroke="{{overlay0.hex}}" />
<rect x="0" y="600" width="1400" height="100" fill="{{if(cond=flavor.light, t=text.hex, f=crust.hex)}}" stroke="{{if(cond=flavor.light, t=text.hex, f=crust.hex)}}" />
</svg>
{% endif %}
