---
whiskers:
  version: "^2.5.1"
  matrix:
    - flavor
  filename: "themes/{{flavor.identifier}}/aroace/aroace.svg"
  hex_format: "#{{r}}{{g}}{{b}}{{z}}"
---
<?xml version="1.0" encoding="UTF-8" ?>
<svg version="1.1" width="1000" height="500" xmlns="http://www.w3.org/2000/svg" shape-rendering="crispEdges">
<rect x="0" y="0" width="1000" height="100" fill="{{peach.hex}}" stroke="{{peach.hex}}" />
<rect x="0" y="100" width="1000" height="100" fill="{{yellow.hex}}" stroke="{{yellow.hex}}" />
<rect x="0" y="200" width="1000" height="100" fill="{{if(cond=flavor.light, t=crust.hex, f=text.hex)}}" stroke="{{if(cond=flavor.light, t=crust.hex, f=text.hex)}}" />
<rect x="0" y="300" width="1000" height="100" fill="{{sky.hex}}" stroke="{{sky.hex}}" />
<rect x="0" y="400" width="1000" height="100" fill="{{blue.hex}}" stroke="{{blue.hex}}" />
</svg>
