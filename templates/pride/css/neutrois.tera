---
whiskers:
  version: "^2.5.1"
  matrix:
    - flavor
  filename: "themes/{{flavor.identifier}}/neutrois/neutrois.css"
  hex_format: "#{{r}}{{g}}{{b}}{{z}}"
---
/* themes/{{flavor.identifier}}/neutrois/neutrois.css */
:root {
  --ctp-{{flavor.identifier}}-neutrois-white: {{if(cond=flavor.light, t=crust.hex, f=text.hex)}};
  --ctp-{{flavor.identifier}}-neutrois-green: {{green.hex}};
  --ctp-{{flavor.identifier}}-neutrois-black: {{if(cond=flavor.light, t=text.hex, f=crust.hex)}};
}
