---
whiskers:
  version: "^2.9.0"
  matrix:
    - variant: ["css", "svg"]
    - flavor
  filename: "themes/{{flavor.identifier}}/greysexual/greysexual.{{ variant }}"
  hex_format: "#{{r}}{{g}}{{b}}{{z}}"
---
/* themes/{{flavor.identifier}}/greysexual/greysexual.{{ variant }} */
{%- if variant == "css" %}
:root {
  --ctp-{{flavor.identifier}}-greysexual-purple: {{mauve.hex}};
  --ctp-{{flavor.identifier}}-greysexual-light-gray: {{overlay2.hex}};
  --ctp-{{flavor.identifier}}-greysexual-white: {{if(cond=flavor.light, t=crust.hex, f=text.hex)}};
}
{%- elif variant == "svg" %}
<?xml version="1.0" encoding="UTF-8" ?>
<svg version="1.1" width="1000" height="500" xmlns="http://www.w3.org/2000/svg" shape-rendering="crispEdges">
<rect x="0" y="0" width="1000" height="100" fill="{{mauve.hex}}" stroke="{{mauve.hex}}" />
<rect x="0" y="100" width="1000" height="100" fill="{{overlay2.hex}}" stroke="{{overlay2.hex}}" />
<rect x="0" y="200" width="1000" height="100" fill="{{if(cond=flavor.light, t=crust.hex, f=text.hex)}}" stroke="{{if(cond=flavor.light, t=crust.hex, f=text.hex)}}" />
<rect x="0" y="300" width="1000" height="100" fill="{{overlay2.hex}}" stroke="{{overlay2.hex}}" />
<rect x="0" y="400" width="1000" height="100" fill="{{mauve.hex}}" stroke="{{mauve.hex}}" />
</svg>
{% endif %}
