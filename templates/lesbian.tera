---
whiskers:
  version: "^2.9.0"
  matrix:
    - variant: ["css", "svg"]
    - flavor
  filename: "themes/{{flavor.identifier}}/lesbian/lesbian.{{ variant }}"
  hex_format: "#{{r}}{{g}}{{b}}{{z}}"
---
/* themes/{{flavor.identifier}}/lesbian/lesbian.{{ variant }} */
{%- if variant == "css" %}
:root {
  --ctp-{{flavor.identifier}}-lesbian-orange: {{red.hex}};
  --ctp-{{flavor.identifier}}-lesbian-yellow: {{peach.hex}};
  --ctp-{{flavor.identifier}}-lesbian-white: {{if(cond=flavor.light, t=crust.hex, f=rosewater.hex)}};
  --ctp-{{flavor.identifier}}-lesbian-maroon: {{mauve | mix(color=red, amount=0.5) | get(key="hex")}};
  --ctp-{{flavor.identifier}}-lesbian-red: {{mauve | mix(color=red, amount=0.5) | sub(lightness=10) | get(key="hex")}};
}
{%- elif variant == "svg" %}
<?xml version="1.0" encoding="UTF-8" ?>
<svg version="1.1" width="1000" height="500" xmlns="http://www.w3.org/2000/svg" shape-rendering="crispEdges">
<rect x="0" y="0" width="1000" height="100" fill="{{red.hex}}" stroke="{{red.hex}}" />
<rect x="0" y="100" width="1000" height="100" fill="{{peach.hex}}" stroke="{{peach.hex}}" />
<rect x="0" y="200" width="1000" height="100" fill="{{if(cond=flavor.light, t=crust.hex, f=rosewater.hex)}}" stroke="{{if(cond=flavor.light, t=crust.hex, f=rosewater.hex)}}" />
<rect x="0" y="300" width="1000" height="100" fill="{{mauve | mix(color=red, amount=0.5) | get(key="hex")}}" stroke="{{mauve | mix(color=red, amount=0.5) | get(key="hex")}}" />
<rect x="0" y="400" width="1000" height="100" fill="{{mauve | mix(color=red, amount=0.5) | sub(lightness=10) | get(key="hex")}}" stroke="{{mauve | mix(color=red, amount=0.5) | sub(lightness=10) | get(key="hex")}}" />
</svg>
{% endif %}
