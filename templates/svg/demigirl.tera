---
whiskers:
  version: "^2.5.1"
  matrix:
    - flavor
  filename: "themes/{{flavor.identifier}}/demigirl/demigirl.svg"
  hex_format: "#{{r}}{{g}}{{b}}"
---
<?xml version="1.0" encoding="UTF-8" ?>
<svg version="1.1" width="1000" height="700" xmlns="http://www.w3.org/2000/svg" shape-rendering="crispEdges">
<rect x="0" y="0" width="1000" height="100" fill="{{overlay0.hex}}" />
<rect x="0" y="100" width="1000" height="100" fill="{{overlay2.hex}}" />
<rect x="0" y="200" width="1000" height="100" fill="{{pink.hex}}" />
<rect x="0" y="300" width="1000" height="100" fill="{{text.hex}}" />
<rect x="0" y="400" width="1000" height="100" fill="{{pink.hex}}" />
<rect x="0" y="500" width="1000" height="100" fill="{{overlay2.hex}}" />
<rect x="0" y="600" width="1000" height="100" fill="{{overlay0.hex}}" />
</svg>
