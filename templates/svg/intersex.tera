---
whiskers:
  version: "^2.5.1"
  matrix:
    - flavor
  filename: "themes/{{flavor.identifier}}/intersex/intersex.css"
  hex_format: "#{{r}}{{g}}{{b}}"
---
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 600">
  <path fill="{{yellow.hex}}" stroke="{{yellow.hex}}"  d="M0 0h900v600H0z"/>
  <circle cx="450" cy="300" r="147" fill="none" stroke-width="50" stroke="{{mauve.hex}}"/>
</svg>
