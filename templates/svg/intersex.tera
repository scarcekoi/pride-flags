---
whiskers:
  version: "^2.9.0"
  matrix:
    - flavor
  filename: "themes/{{flavor.identifier}}/intersex/intersex.svg"
  hex_format: "#{{r}}{{g}}{{b}}{{z}}"
---
<svg xmlns="http://www.w3.org/2000/svg" width="600" height="300" viewBox="0 0 600 300">
  <path fill="{{yellow.hex}}" stroke="{{yellow.hex}}"  d="M0 0h600v300H0z"/>
  <circle cx="300" cy="150" r="73.5" fill="none" stroke-width="25" stroke="{{mauve.hex}}"/>
</svg>
