---
whiskers:
  version: "^2.5.1"
  matrix:
    - flavor
  filename: "themes/{{flavor.identifier}}/genderqueer/genderqueer.svg"
  hex_format: "#{{r}}{{g}}{{b}}"
---
<?xml version="1.0" encoding="UTF-8" ?>
<svg version="1.1" width="600" height="300" xmlns="http://www.w3.org/2000/svg" shape-rendering="crispEdges">
<rect x="0" y="0" width="600" height="100" fill="{{mauve.hex}}" />
<rect x="0" y="100" width="600" height="100" fill="{{if(cond=flavor.light, t=crust.hex, f=text.hex)}}" />
<rect x="0" y="200" width="600" height="100" fill="{{green.hex}}" />
</svg>
