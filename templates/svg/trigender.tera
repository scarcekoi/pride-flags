---
whiskers:
  version: "^2.5.1"
  matrix:
    - flavor
  filename: "themes/{{flavor.identifier}}/trigender/trigender.svg"
  hex_format: "#{{r}}{{g}}{{b}}"
---
<?xml version="1.0" encoding="UTF-8" ?>
<svg version="1.1" width="1000" height="500" xmlns="http://www.w3.org/2000/svg" shape-rendering="crispEdges">
<rect x="0" y="0" width="1000" height="100" fill="{{pink.hex}}" stroke="{{pink.hex}}" />
<rect x="0" y="100" width="1000" height="100" fill="{{mauve.hex}}" stroke="{{mauve.hex}}" />
<rect x="0" y="200" width="1000" height="100" fill="{{green.hex}}" stroke="{{green.hex}}" />
<rect x="0" y="300" width="1000" height="100" fill="{{mauve.hex}}" stroke="{{mauve.hex}}" />
<rect x="0" y="400" width="1000" height="100" fill="{{pink.hex}}" stroke="{{pink.hex}}" />
</svg>
