---
whiskers:
  version: "^2.5.1"
  matrix:
    - flavor
  filename: "themes/{{flavor.identifier}}/polyam/polyam-evans/polyam-evans.svg"
  hex_format: "#{{r}}{{g}}{{b}}{{z}}"
---
<?xml version="1.0" encoding="UTF-8" ?>
<svg version="1.1" width="600" height="300" xmlns="http://www.w3.org/2000/svg" shape-rendering="crispEdges">
<rect x="0" y="0" width="600" height="100" fill="{{blue.hex}}" stroke="{{blue.hex}}" />
<rect x="0" y="100" width="600" height="100" fill="{{red.hex}}" stroke="{{red.hex}}" />
<rect x="0" y="200" width="600" height="100" fill="{{if(cond=flavor.light, t=text.hex, f=crust.hex)}}" stroke="{{if(cond=flavor.light, t=text.hex, f=crust.hex)}}" />
<text x="300" y="150" text-anchor="middle" dominant-baseline="middle" fill="{{yellow.hex}}" font-size="150" font-family="Times New Roman">π</text>
</svg>
