---
whiskers:
  version: "^2.5.1"
  matrix:
    - flavor
  filename: "themes/{{flavor.identifier}}/cisgender/cisgender.svg"
  hex_format: "#{{r}}{{g}}{{b}}"
---
<?xml version="1.0" encoding="UTF-8" ?>
<svg version="1.1" width="250" height="200" xmlns="http://www.w3.org/2000/svg" shape-rendering="crispEdges">
<rect x="0" y="0" width="250" height="100" fill="{{pink.hex}}" />
<rect x="0" y="100" width="250" height="100" fill="{{blue.hex}}" />
</svg>
