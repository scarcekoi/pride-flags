---
whiskers:
  version: "^2.5.1"
  matrix:
    - flavor
  filename: "themes/{{flavor.identifier}}/pride/pride.svg"
  hex_format: "#{{r}}{{g}}{{b}}"
---
<?xml version="1.0" encoding="UTF-8" ?>
<svg version="1.1" width="1200" height="600" xmlns="http://www.w3.org/2000/svg" shape-rendering="crispEdges">
<rect x="0" y="0" width="1200" height="100" fill="{{red.hex}}" />
<rect x="0" y="100" width="1200" height="100" fill="{{peach.hex}}" />
<rect x="0" y="200" width="1200" height="100" fill="{{yellow.hex}}" />
<rect x="0" y="300" width="1200" height="100" fill="#green.hex" />
<rect x="0" y="400" width="1200" height="100" fill="{{sky.hex}}" />
<rect x="0" y="500" width="1200" height="100" fill="{{mauve.hex}}" />
</svg>
