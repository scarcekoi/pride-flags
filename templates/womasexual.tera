---
whiskers:
  version: "^2.9.0"
  matrix:
    - variant: ["css", "svg"]
    - flavor
  filename: "themes/{{flavor.identifier}}/womasexual/womasexual.{{ variant }}"
  hex_format: "#{{r}}{{g}}{{b}}{{z}}"
---
/* themes/{{flavor.identifier}}/womasexual/womasexual.{{ variant }} */
{%- if variant == "css" %}
:root {
  --ctp-{{flavor.identifier}}-womasexual-red: {{red.hex}};
  --ctp-{{flavor.identifier}}-womasexual-maroon: {{maroon.hex}};
  --ctp-{{flavor.identifier}}-womasexual-pink: {{pink.hex}};
  --ctp-{{flavor.identifier}}-womasexual-light-pink: {{flamingo.hex}};
  --ctp-{{flavor.identifier}}-womasexual-white: {{if(cond=flavor.light, t=crust.hex, f=text.hex)}};
}
{%- elif variant == "svg" %}
<?xml version="1.0" encoding="UTF-8" ?>
<svg version="1.1" width="1000" height="500" xmlns="http://www.w3.org/2000/svg" shape-rendering="crispEdges">
<rect x="0" y="0" width="1000" height="100" fill="{{red.hex}}" stroke="{{red.hex}}" />
<rect x="0" y="100" width="1000" height="100" fill="{{maroon.hex}}" stroke="{{maroon.hex}}" />
<rect x="0" y="200" width="1000" height="100" fill="{{pink.hex}}" stroke="{{pink.hex}}" />
<rect x="0" y="300" width="1000" height="100" fill="{{flamingo.hex}}" stroke="{{flamingo.hex}}" />
<rect x="0" y="400" width="1000" height="100" fill="{{if(cond=flavor.light, t=crust.hex, f=text.hex)}}" stroke="{{if(cond=flavor.light, t=crust.hex, f=text.hex)}}" />
</svg>
{% endif %}
