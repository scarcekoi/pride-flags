---
whiskers:
  version: "^2.9.0"
  matrix:
    - variant: ["css", "svg"]
    - flavor
  filename: "themes/{{flavor.identifier}}/transfeminine-ryanyflags/transfeminine-ryanyflags.{{ variant }}"
  hex_format: "#{{r}}{{g}}{{b}}{{z}}"
---
/* themes/{{flavor.identifier}}/transfeminine-ryanyflags/transfeminine-ryanyflags.{{ variant }} */
{%- if variant == "css" %}
:root {
  --ctp-{{flavor.identifier}}-transfeminine-ryanyflags-lighter-pink: {{if(cond=flavor.light, t=crust.hex, f=rosewater.hex)}};
  --ctp-{{flavor.identifier}}-transfeminine-ryanyflags-light-red: {{maroon.hex}};
  --ctp-{{flavor.identifier}}-transfeminine-ryanyflags-red: {{red.hex}};
  --ctp-{{flavor.identifier}}-transfeminine-ryanyflags-black: {{if(cond=flavor.light, t=text.hex, f=crust.hex)}};
}
{%- elif variant == "svg" %}
<?xml version="1.0" encoding="UTF-8" ?>
<svg version="1.1" width="800" height="400" xmlns="http://www.w3.org/2000/svg" shape-rendering="crispEdges">
<rect x="0" y="0" width="800" height="100" fill="{{if(cond=flavor.light, t=crust.hex, f=rosewater.hex)}}" stroke="{{if(cond=flavor.light, t=crust.hex, f=rosewater.hex)}}" />
<rect x="0" y="100" width="800" height="100" fill="{{maroon.hex}}" stroke="{{maroon.hex}}" />
<rect x="0" y="200" width="800" height="100" fill="{{red.hex}}" stroke="{{red.hex}}" />
<rect x="0" y="300" width="800" height="100" fill="{{if(cond=flavor.light, t=text.hex, f=crust.hex)}}" stroke="{{if(cond=flavor.light, t=text.hex, f=crust.hex)}}" />
</svg>
{% endif %}
