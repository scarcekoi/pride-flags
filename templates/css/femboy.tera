---
whiskers:
  version: "^2.9.0"
  matrix:
    - flavor
  filename: "themes/{{flavor.identifier}}/femboy/femboy.css"
  hex_format: "#{{r}}{{g}}{{b}}"
---
/* themes/{{flavor.identifier}}/femboy/femboy.css */
:root {
  --ctp-{{flavor.identifier}}-femboy-pink: {{red.hex}};
  --ctp-{{flavor.identifier}}-femboy-light-pink: {{maroon.hex}};
  --ctp-{{flavor.identifier}}-femboy-white: {{if(cond=flavor.light, t=crust.hex, f=rosewater.hex)}};
  --ctp-{{flavor.identifier}}-femboy-blue: {{blue.hex}};
}
