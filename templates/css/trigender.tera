---
whiskers:
  version: "^2.5.1"
  matrix:
    - flavor
  filename: "themes/{{flavor.identifier}}/trigender/trigender.css"
  hex_format: "#{{r}}{{g}}{{b}}"
---
/* themes/{{flavor.identifier}}/trigender/trigender.css */
:root {
  --ctp-{{flavor.identifier}}-trigender-pink: {{pink.hex}};
  --ctp-{{flavor.identifier}}-trigender-purple: {{mauve.hex}};
  --ctp-{{flavor.identifier}}-trigender-green: {{green.hex}};
}
