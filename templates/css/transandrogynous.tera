---
whiskers:
  version: "^2.5.1"
  matrix:
    - flavor
  filename: "themes/{{flavor.identifier}}/transandrogynous/transandrogynous.css"
  hex_format: "#{{r}}{{g}}{{b}}"
---
/* themes/{{flavor.identifier}}/transandrogynous/transandrogynous.css */
:root {
  --ctp-{{flavor.identifier}}-transandrogynous-purple: {{mauve.hex}};
  --ctp-{{flavor.identifier}}-transandrogynous-pink: {{pink.hex}};
  --ctp-{{flavor.identifier}}-transandrogynous-white: {{if(cond=flavor.light, t=crust.hex, f=text.hex)}};
}
