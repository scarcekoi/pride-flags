---
whiskers:
  version: "^2.5.1"
  matrix:
    - flavor
  filename: "themes/{{flavor.identifier}}/demigirl/demigirl.css"
  hex_format: "#{{r}}{{g}}{{b}}"
---
/* themes/{{flavor.identifier}}/demigirl/demigirl.css */
:root {
  --ctp-{{flavor.identifier}}-demigirl-light-gray: {{if(cond=flavor.light, t=overlay2.hex, f=overlay0.hex)}};
  --ctp-{{flavor.identifier}}-demigirl-dark-gray: {{if(cond=flavor.light, t=overlay0.hex, f=overlay2.hex)}};
  --ctp-{{flavor.identifier}}-demigirl-pink: {{pink.hex}};
  --ctp-{{flavor.identifier}}-demigirl-white: {{if(cond=flavor.light, t=crust.hex, f=text.hex)}};
}
