---
whiskers:
  version: "^2.5.1"
  matrix:
    - flavor
  filename: "themes/{{flavor.identifier}}/transfeminine/transfeminine.svg"
  hex_format: "#{{r}}{{g}}{{b}}"
---
<?xml version="1.0" encoding="UTF-8" ?>
<svg version="1.1" width="1000" height="700" xmlns="http://www.w3.org/2000/svg" shape-rendering="crispEdges">
<rect x="0" y="0" width="1000" height="100" fill="{{sapphire.hex}}" stroke="{{sapphire.hex}}" />
<rect x="0" y="100" width="1000" height="100" fill="{{if(cond=flavor.light, t=crust.hex, f=rosewater.hex)}}" stroke="{{if(cond=flavor.light, t=crust.hex, f=rosewater.hex)}}" />
<rect x="0" y="200" width="1000" height="100" fill="{{if(cond=flavor.light, t=rosewater.hex, f=maroon.hex)}}" stroke="{{if(cond=flavor.light, t=rosewater.hex, f=maroon.hex)}}" />
<rect x="0" y="300" width="1000" height="100" fill="{{if(cond=flavor.light, t=flamingo.hex, f=red.hex)}}" stroke="{{if(cond=flavor.light, t=flamingo.hex, f=red.hex)}}" />
<rect x="0" y="400" width="1000" height="100" fill="{{if(cond=flavor.light, t=rosewater.hex, f=maroon.hex)}}" stroke="{{if(cond=flavor.light, t=rosewater.hex, f=maroon.hex)}}" />
<rect x="0" y="500" width="1000" height="100" fill="{{if(cond=flavor.light, t=crust.hex, f=rosewater.hex)}}" stroke="{{if(cond=flavor.light, t=crust.hex, f=rosewater.hex)}}" />
<rect x="0" y="600" width="1000" height="100" fill="{{sapphire.hex}}" stroke="{{sapphire.hex}}" />
</svg>
