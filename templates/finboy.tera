---
whiskers:
  version: "^2.9.0"
  matrix:
    - variant: ["css", "svg"]
    - flavor
  filename: "themes/{{flavor.identifier}}/finboy/finboy.{{ variant }}"
  hex_format: "#{{r}}{{g}}{{b}}{{z}}"
---
/* themes/{{flavor.identifier}}/finboy/finboy.{{ variant }} */
{%- if variant == "css" %}
:root {
  --ctp-{{flavor.identifier}}-finboy-yellow: {{yellow.hex}}
  --ctp-{{flavor.identifier}}-finboy-pink: {{pink.hex}}
  --ctp-{{flavor.identifier}}-finboy-purple: {{mauve.hex}}
  --ctp-{{flavor.identifier}}-finboy-blue: {{blue.hex}}
  --ctp-{{flavor.identifier}}-finboy-light-blue: {{sky.hex}}
}
{%- elif variant == "svg" %}
<?xml version="1.0" encoding="UTF-8" ?>
<svg version="1.1" width="1000" height="600" xmlns="http://www.w3.org/2000/svg" shape-rendering="crispEdges">
<rect x="0" y="0" width="1000" height="100" fill="{{yellow.hex}}" />
<rect x="0" y="100" width="1000" height="100" fill="{{pink.hex}}" />
<rect x="0" y="200" width="1000" height="200" fill="{{mauve.hex}}" />
<rect x="0" y="400" width="1000" height="100" fill="{{blue.hex}}" />
<rect x="0" y="500" width="1000" height="100" fill="{{sky.hex}}" />
</svg>
{% endif %}
